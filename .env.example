# =============================================================================
# Pixtrela Next.js — environment template
# Copy to `.env.local` (gitignored) for laptop / Cursor Cloud.
# On Vercel: set the same keys in Project → Settings → Environment Variables.
# Full matrix: docs/ENV-VERCEL-CURSOR.md | VPS DB: docs/VPS-POSTGRES.md
# =============================================================================

# --- Auth.js v5 (required) ---
# Generate: openssl rand -base64 32
AUTH_SECRET=dev-only-secret-change-me
# Optional alias (Auth.js / login ticket also accept NEXTAUTH_SECRET):
# NEXTAUTH_SECRET=
AUTH_TRUST_HOST=true
# Must match the URL opened in the browser (port-forward / domain).
# Laptop / Cursor forward: http://localhost:3000
# Vercel production: https://pixtrela.com  (or your canonical domain)
AUTH_URL=http://localhost:3000

# --- Postgres (required) ---
# Cursor Cloud / laptop (dev): VPS postgres-dev on :5433 — no SSH tunnel
# Vercel production: VPS postgres-prod on :5432 (+ ?sslmode=require when TLS is on)
#
# Examples:
#   Dev:   postgresql://USER:PASS@VPS_HOST:5433/pixtrela_dev
#   Prod:  postgresql://USER:PASS@VPS_HOST:5432/pixtrela
DATABASE_URL=postgresql://pixtrela:pixtrela@127.0.0.1:5432/pixtrela

# Optional seed overrides (npm run db:seed / db:seed:e2e)
# SEED_ADMIN_USERNAME=admin
# SEED_ADMIN_PASSWORD=PixtrelaAdmin1

# --- Media ---
# local = ./storage (dev laptop). s3 = Cloudflare R2 (Vercel / shared).
MEDIA_DRIVER=local
# R2 example (see .local-secrets/r2.env — never commit secrets):
# MEDIA_DRIVER=s3
# S3_BUCKET=pixtrela-media
# S3_REGION=auto
# S3_ENDPOINT=https://<ACCOUNT_ID>.r2.cloudflarestorage.com
# S3_ACCESS_KEY_ID=
# S3_SECRET_ACCESS_KEY=
# S3_PUBLIC_URL=https://media.pixtrela.ribermax.com.br
# S3_FORCE_PATH_STYLE=true

# --- One-time ETL from legacy Strapi DB (npm run db:etl only) ---
# STRAPI_DATABASE_URL=

# --- Integrations (optional) ---
# Password reset emails (SMTP)
# SMTP_HOST=smtp.example.com
# SMTP_PORT=587
# SMTP_SECURE=false
# SMTP_USER=
# SMTP_PASS=
# FROM_EMAIL=App <noreply@your-domain.com>
# LEGACY_RBX_URL=http://localhost
# LEGACY_RBX_TOKEN=
# CRM_WEBHOOK_SECRET=

# --- Playwright E2E (optional; loaded from .env.local by playwright.config) ---
E2E_MANAGER_LOGIN=e2e-manager
E2E_MANAGER_PASSWORD=PixtrelaE2e1
# E2E_COLABORATOR_LOGIN=
# E2E_COLABORATOR_PASSWORD=
# E2E_KIOSK_LOGIN=
# E2E_KIOSK_PASSWORD=

# --- Dev tooling (optional) ---
# RUN_DB_TESTS=1
# PIXTRELA_VPS_SSH=deploy@your-vps.example
