# Auth.js v5
AUTH_SECRET=dev-only-secret-change-me
AUTH_TRUST_HOST=true
# Use the same origin you open in the browser (localhost vs 127.0.0.1).
# Mismatched hosts make Auth.js rewrite callback URLs and look like redirect loops.
# AUTH_URL=http://localhost:3000

# Data backend: drizzle (default, greenfield Postgres) | strapi (legacy)
DATA_BACKEND=drizzle
# Cutover: set to 0 to disable Strapi JWT preference (Auth.js/Postgres only)
AUTH_STRAPI_FALLBACK=1

# Postgres
# Laptop: docker compose up -d (root) → 5432
# Cursor Cloud → VPS postgres-dev: see docs/ENV-VERCEL-CURSOR.md (SSH -L 5433)
# Vercel → VPS postgres-prod: see docs/VPS-POSTGRES.md
DATABASE_URL=postgresql://pixtrela:pixtrela@127.0.0.1:5432/pixtrela

# Media: local filesystem (default) or s3
MEDIA_DRIVER=local
# S3_BUCKET=
# S3_REGION=auto
# S3_ENDPOINT=
# S3_ACCESS_KEY_ID=
# S3_SECRET_ACCESS_KEY=
# S3_PUBLIC_URL=
# S3_FORCE_PATH_STYLE=true

# Strapi backend base URL (legacy coexistence only; no trailing slash)
STRAPI_URL=http://127.0.0.1:1337

# ETL cutover source (Strapi DB)
# STRAPI_DATABASE_URL=

# Pixtrela Strapi API token (create in Strapi admin; grant task + template-task + step).
# Used server-side by the webhook handler only — never expose to the browser.
STRAPI_SYNC_API_TOKEN=

# Legacy RBX (WordPress) — template subtasks by prodId when CRM pedido is imported.
# LEGACY_RBX_URL is the site base URL (no trailing slash); products route is
# `${LEGACY_RBX_URL}/produtos`.
LEGACY_RBX_URL=http://localhost
LEGACY_RBX_TOKEN=

# CRM webhook — sys-rbx-backend POSTs pedido updates to /api/webhooks/crm-pedido.
# Must match PIXTRELA_WEBHOOK_SECRET on CRM Strapi.
CRM_WEBHOOK_SECRET=

# Playwright E2E — copy these into `.env.local` (loaded by playwright.config).
E2E_MANAGER_LOGIN=e2e-manager
E2E_MANAGER_PASSWORD=PixtrelaE2e1
E2E_COLABORATOR_LOGIN=
E2E_COLABORATOR_PASSWORD=
E2E_KIOSK_LOGIN=
E2E_KIOSK_PASSWORD=
