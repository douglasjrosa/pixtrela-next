# Copy to .env.db on the VPS (never commit .env.db).
#   cp env.db.example .env.db

# --- Production Postgres (Vercel connects here) ---
PROD_PG_HOST_BIND=0.0.0.0
PROD_PG_PORT=5432
PROD_PG_USER=pixtrela
PROD_PG_PASSWORD=change-me-strong-prod-password
PROD_PG_DB=pixtrela

# --- Development Postgres (SSH tunnel only; bound to 127.0.0.1) ---
DEV_PG_PORT=5433
DEV_PG_USER=pixtrela
DEV_PG_PASSWORD=change-me-strong-dev-password
DEV_PG_DB=pixtrela_dev
