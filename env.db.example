# =============================================================================
# VPS Postgres containers — copy to `.env.db` next to docker-compose.db.yml
#   cp env.db.example .env.db
#   chmod 600 .env.db
# Never commit `.env.db`. Used by: docker compose -f docker-compose.db.yml --env-file .env.db up -d
# Docs: docs/VPS-POSTGRES.md
# =============================================================================

# --- Production (Vercel DATABASE_URL points here) ---
PROD_PG_HOST_BIND=0.0.0.0
PROD_PG_PORT=5432
PROD_PG_USER=pixtrela
PROD_PG_PASSWORD=change-me-strong-prod-password
PROD_PG_DB=pixtrela

# After start, Next/Vercel connection string looks like:
# DATABASE_URL=postgresql://pixtrela:PROD_PASSWORD@VPS_HOST:5432/pixtrela?sslmode=require

# --- Development (public :5433 for Cursor Cloud Agents — no SSH tunnel) ---
DEV_PG_HOST_BIND=0.0.0.0
DEV_PG_PORT=5433
DEV_PG_USER=pixtrela
DEV_PG_PASSWORD=change-me-strong-dev-password
DEV_PG_DB=pixtrela_dev

# Cursor Cloud / laptop (direct):
# DATABASE_URL=postgresql://pixtrela:DEV_PASSWORD@VPS_HOST:5433/pixtrela_dev
