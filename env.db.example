# =============================================================================
# VPS production Postgres — copy to `.env.db` next to docker-compose.db.yml
#   cp env.db.example .env.db
#   chmod 600 .env.db
# Never commit `.env.db`. Used by: docker compose -f docker-compose.db.yml --env-file .env.db up -d
# Docs: docs/VPS-POSTGRES.md
# =============================================================================

PROD_PG_HOST_BIND=127.0.0.1
PROD_PG_PORT=5432
PROD_PG_USER=pixtrela
PROD_PG_PASSWORD=change-me-strong-prod-password
PROD_PG_DB=pixtrela

# App container:
# DATABASE_URL=postgresql://pixtrela:PROD_PASSWORD@pixtrela-postgres-prod:5432/pixtrela
