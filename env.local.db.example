# =============================================================================
# Laptop Postgres — copy to `.env.local.db` next to docker-compose.yml
#   cp env.local.db.example .env.local.db
#   chmod 600 .env.local.db
# Never commit `.env.local.db`.
# =============================================================================

LOCAL_PG_PORT=5432
LOCAL_PG_USER=pixtrela
LOCAL_PG_PASSWORD=change-me-strong-local-password
LOCAL_PG_DB=pixtrela

# Then in `.env.local`:
# DATABASE_URL=postgresql://pixtrela:PASSWORD@127.0.0.1:5432/pixtrela
